# Copiá este archivo como ".env" y completalo. El archivo .env NO se sube a GitHub.
# En Railway, estas mismas variables se cargan en la pestaña "Variables" del servicio.

# Contraseña del panel (/admin). Obligatoria: sin ella el panel queda desactivado.
ADMIN_PASSWORD=

# Contraseña de la pantalla de la puerta (/puerta), para el personal de la puerta.
# Solo deja ver los pedidos pagados y marcar quién entró. El dueño también entra con ADMIN_PASSWORD.
PUERTA_PASSWORD=

# Access Token de Mercado Pago (Tus integraciones > Credenciales). Opcional:
# sin él, los pedidos aprobados se pagan por transferencia.
MP_ACCESS_TOKEN=

# Dirección pública de la página, por ejemplo https://mi-productora.up.railway.app
# (se usa para los links de pago y los avisos de Mercado Pago).
PUBLIC_URL=

# Opcionales
# INITIAL_CODE=MEDIANOCHE   # código del RRPP "General" que se crea la primera vez
# CLUB_NAME=medianoche      # nombre inicial (después se cambia en Ajustes)
# SESSION_SECRET=           # si no está, se genera una sola vez y se guarda en la base
# DATA_DIR=/data            # carpeta de la base de datos (en Railway, la del Volume)
